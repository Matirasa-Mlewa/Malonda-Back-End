# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/malonda?schema=public

# ─── JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=replace_with_64_char_random_hex_string
JWT_REFRESH_SECRET=replace_with_different_64_char_random_hex_string

# ─── Africa's Talking (SMS / OTP) ─────────────────────────────────────────────
# Sign up at: https://africastalking.com
# Use username "sandbox" and any API key for development
AT_USERNAME=sandbox
AT_API_KEY=your_africastalking_api_key
AT_SENDER_ID=MALONDA

# ─── Cloudinary (Image Storage) ───────────────────────────────────────────────
# Sign up at: https://cloudinary.com (free tier is enough to start)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Airtel Money (Malawi) ────────────────────────────────────────────────────
# Apply at: https://developers.airtel.africa
AIRTEL_CLIENT_ID=your_airtel_client_id
AIRTEL_CLIENT_SECRET=your_airtel_client_secret

# ─── TNM Mpamba ───────────────────────────────────────────────────────────────
# Contact TNM Malawi for merchant API access
TNM_API_KEY=your_tnm_api_key
TNM_API_URL=https://api.tnmmpamba.co.mw/v1

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
